{
  "name": "@getpaseo/foundation-cli",
  "version": "0.7.0-paseo.59",
  "private": true,
  "description": "Install and diagnose the Paseo Foundation distribution",
  "bin": {
    "paseo-foundation": "bin/paseo-foundation"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "prepack": "node prepare-assets.mjs && npm run build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run src",
    "test:package-lifecycle": "node scripts/package-lifecycle-smoke.mjs"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
